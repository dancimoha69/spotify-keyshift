<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AssemblyName>KeyShift</AssemblyName>
    <RootNamespace>KeyShiftBridge</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.2.0" />
    <PackageReference Include="SoundTouch.Net" Version="2.3.2" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\keyshift.js" LogicalName="KeyShiftSetup.Payload.keyshift.js" />
    <EmbeddedResource Include="..\THIRD_PARTY_NOTICES.md" LogicalName="KeyShiftSetup.Payload.THIRD_PARTY_NOTICES.md" />
  </ItemGroup>
</Project>
